# Optional: bake your Supabase project into the build so devices only need to
# sign in. Both values are public by design; row level security protects data.
# Copy to .env.local and fill in (Project Settings → API in Supabase).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
